# Install script (preinstall/postinstall...) là đường lây chính của các đợt
# chiếm quyền package npm năm 2026. Chỉ cho chạy script đã duyệt trong
# "allowScripts" của package.json (ghim theo phiên bản); gặp script lạ thì
# DỪNG cài thay vì lặng lẽ chạy. Nâng esbuild/better-sqlite3 lên bản mới thì
# duyệt lại: npm install-scripts approve <pkg>
strict-allow-scripts=true
